# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tuition_manager?schema=public"

# JWT signing key — use a long random string in production
SECRET_KEY="change-me-to-a-long-random-string"

PORT=3000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"

# Set to "false" to disable the daily 9 AM reminder job (e.g. on extra instances)
ENABLE_SCHEDULER=true

# --- WhatsApp Cloud API (optional) ---
# Without these, reminders are queued for one-tap sending via wa.me links.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_BEFORE=
WHATSAPP_TEMPLATE_AFTER=
WHATSAPP_API_VERSION=v21.0
